# Database (Supabase or local PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flashcards
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# JWT Secret (min 64 characters, base64 encoded)
JWT_SECRET_KEY=your_base64_encoded_secret_key_min_256_bits

# Email (Gmail SMTP)
SUPPORT_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password

# CSRF (false for development, true for production)
CSRF_SECURE_COOKIE=false
